{
  "name": "carapana-delivery-0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @carapana/web dev",
    "build": "pnpm --filter @carapana/web build",
    "check": "pnpm --filter @carapana/web check",
    "lint": "biome lint --error-on-warnings . && pnpm --filter @carapana/web lint",
    "lint:fix": "biome check --write . && pnpm --filter @carapana/web lint:fix",
    "test": "pnpm --filter @carapana/web test",
    "test:e2e": "pnpm --filter @carapana/web test:e2e",
    "format": "biome format --write . && prettier --write .",
    "format:check": "biome ci --error-on-warnings . && prettier --check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
