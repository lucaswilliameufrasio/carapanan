{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.{js,ts,json,css}",
      "!**/.svelte-kit",
      "!**/build",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } },
  "css": { "parser": { "tailwindDirectives": true }, "formatter": { "enabled": true } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["apps/web/src/app.css"],
      "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
    },
    {
      "includes": ["**/*.test.ts", "**/tests/**/*.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
